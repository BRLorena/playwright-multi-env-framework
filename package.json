{
  "name": "todo-app-multi-env",
  "version": "1.0.0",
  "description": "TODO CRUD app with multi-environment UI for automation test practice",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "start:stable": "ENV_NAME=stable node dist/server.js",
    "start:release": "ENV_NAME=release node dist/server.js",
    "start:int": "ENV_NAME=int node dist/server.js",
    "dev": "ts-node app/server.ts",
    "dev:stable": "ENV_NAME=stable ts-node app/server.ts",
    "dev:release": "ENV_NAME=release ts-node app/server.ts",
    "dev:int": "ENV_NAME=int ts-node app/server.ts",
    "test": "playwright test",
    "test:stable": "playwright test --project=stable",
    "test:release": "playwright test --project=release",
    "test:int": "playwright test --project=int",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,mjs,json}\"",
    "format:check": "prettier --check \"**/*.{ts,mjs,json}\"",
    "check": "npm run typecheck && npm run lint && npm run format:check"
  },
  "dependencies": {
    "dotenv": "^17.4.1",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.20.5",
    "allure-playwright": "^3.14.0",
    "eslint": "^10.13.0",
    "eslint-plugin-playwright": "^2.12.1",
    "prettier": "^3.9.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.72.0"
  },
  "engines": {
    "node": ">=22"
  }
}
