{
  // Type-checks everything (app, tests, config). The app build uses tsconfig.build.json.
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "include": ["app/**/*", "tests/**/*", "config/**/*", "playwright.config.ts"],
  "exclude": ["node_modules", "dist"]
}
